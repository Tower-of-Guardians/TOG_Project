  m_Name: Relic_Krabian'sCanine
  m_EditorClassIdentifier: 
  rowID: Relic_Krabian'sCanine
  isEnable: 1
  displayName: "\uD06C\uB77C\uBE44\uC548\uC758 \uC1A1\uACF3\uB2C8"
  displayImage: {fileID: 0}
  relicType: 0
  description: "\uD0D1\uC758 \uC0C1\uC778\uC778 \uB9C8\uC871 \uD06C\uB77C\uBE44\uC548\uC774
    \uACE0\uB9C8\uC6C0\uC758 \uD45C\uC2DC\uB85C \uC900 \uC120\uBB3C\uC785\uB2C8\uB2E4.
    \"\uB9C8\uC871\uC758 \uC774\uBE68\uC744 \uC804\uB9AC\uD488\uC73C\uB85C \uC5BB\uC740
    \uAC8C \uC544\uB2C8\uB77C \uB9C8\uC871\uD55C\uD14C \uC120\uBB3C \uBC1B\uC740
    \uAC70\uB77C\uACE0 \uB9D0\uD558\uACE0 \uB2E4\uB2C8\uBA74 \uC815\uC2E0\uB098\uAC04
    \uB188 \uCDE8\uAE09\uC744 \uBC1B\uACA0\uC9C0.\""
  condition: "\uC0C1\uC810\uC5D0 \uC788\uB294 \uBAA8\uB4E0 \uD488\uBAA9\uC744 \uAD6C\uB9E4\uD55C
    \uD6C4 \uD06C\uB77C\uBE44\uC548\uACFC\uC758 \uB300\uD654\uB97C \uD1B5\uD574 \uD68D\uB4DD"
  effectIDs:
  - RelicEffect_001
